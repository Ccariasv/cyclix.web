Options -MultiViews
RewriteEngine On
RewriteBase /

# Proxy API requests through the same origin before the SPA fallback runs.
RewriteRule ^api/(.*)$ https://api.cyclix.site/api/$1 [P,L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
